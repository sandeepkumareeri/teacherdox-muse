# ─── Meta Hackathon: teacherdox-muse ────────────────────────────────────────
# Copy this to .env and fill in your values.
# Secrets (META_API_KEY, etc.) go in GitHub Secrets; the deploy writes them to /etc/teacherdox.env

# ─── AI Backend ──────────────────────────────────────────────────────────────
# "meta" = use Meta Model API (Muse Spark, Voice Transcribe, SAM 3.1)
# "gemini" = use Google Gemini (default, production)
AI_BACKEND=gemini

# Meta Model API (dev.meta.ai) — required when AI_BACKEND=meta
META_API_KEY=

# Meta model IDs (from dev.meta.ai docs — confirm exact IDs)
META_MODEL_CHAT=meta-llama/Llama-3.3-70B-Instruct
META_MODEL_VISION=meta-llama/Llama-3.2-90B-Vision-Instruct
META_MODEL_TRANSCRIBE=muse-voice-transcribe
META_MODEL_SAM=sam-3.1

# Allow-list for Meta backend (privacy: free credits = content may be used for improvement)
# Comma-separated WhatsApp numbers (digits with country code), or "all"
# Default: empty = no one uses Meta backend in production
META_AI_PHONES=

# Daily limits for Meta (mirrors Gemini limits in gemini.js)
META_DAILY_LIMIT=500
META_DAILY_LIMIT_PER_USER=40

# ─── Google Gemini (existing, fallback) ──────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BACKEND=
GEMINI_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT_PER_USER=40

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PUBLIC_STORAGE_URL=
RENDER_URL=https://teacherdox.onrender.com

# ─── Admin / Support ─────────────────────────────────────────────────────────
ADMIN_PHONES=
SUPPORT_PHONE=

# Session secret (signs sign-in cookies and diary links)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── WhatsApp Provider (AiSensy or Meta Cloud API) ───────────────────────────
WHATSAPP_PROVIDER=
WHATSAPP_BUSINESS_NUMBER=

# AiSensy
AISENSY_API_KEY=
AISENSY_PROJECT_API_KEY=
AISENSY_SEND_URL=
AISENSY_PROJECT_ID=
AISENSY_AUTH_HEADER=
AISENSY_CAMPAIGN_URL=
AISENSY_WEBHOOK_SECRET=
AISENSY_LOG_PAYLOADS=
AISENSY_INTERACTIVE=

# Meta Cloud API (direct)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=

# WhatsApp Templates (create + approve in WhatsApp Manager)
WHATSAPP_REENGAGE_TEMPLATE=
WHATSAPP_OTP_TEMPLATE=

# ─── Zero-Effort Mode ────────────────────────────────────────────────────────
ZERO_EFFORT_PHONES=
ZERO_EFFORT_DAILY_CAP=3
DIGEST_TIME=16:30
AUTO_SUBMIT_TIME=20:00
CANVAS_QUIET_SECONDS=10
WHATSAPP_TEMPLATE_LANG=en

# ─── Billing (Razorpay) ──────────────────────────────────────────────────────
BILLING_MODE=off
BILLING_TRIAL_DAYS=30
BILLING_REMIND_DAY=25
BILLING_PRICE_INR=99
BILLING_QUARTERLY_PRICE_INR=279
BILLING_YEARLY_PRICE_INR=999
BILLING_REMIND_TIME=10:00
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Members ─────────────────────────────────────────────────────────────────
FOUNDING_MEMBERS=1000
MEMBER_INVITES=3

# ─── School Directory ────────────────────────────────────────────────────────
GEO_DB_PATH=/var/lib/teacherdox/geo.sqlite
CORS_ORIGINS=

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata