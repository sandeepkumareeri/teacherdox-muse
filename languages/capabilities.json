{
  "version": "1.0",
  "description": "TeacherDox Language Capabilities Matrix — 100+ languages via Meta NLLB/SeamlessM4T/Llama",
  "models": {
    "nllb": {
      "name": "NLLB-200",
      "version": "distilled-600M / 3.3B",
      "languages": 200,
      "tasks": ["translation", "cross-lingual evaluation"],
      "apiEndpoint": "/translation",
      "status": "requires META_API_KEY with NLLB access"
    },
    "seamlessm4t": {
      "name": "SeamlessM4T v2",
      "version": "large / medium",
      "languages": 101,
      "tasks": ["speech-to-text (ASR)", "speech-to-speech (S2ST)", "text-to-speech (TTS)", "text-to-text translation"],
      "apiEndpoint": "/audio/transcriptions, /audio/translate, /audio/speech",
      "status": "requires META_API_KEY with SeamlessM4T access"
    },
    "llama": {
      "name": "Llama 3.3 70B Instruct",
      "version": "3.3",
      "languages": "100+ (multilingual training)",
      "tasks": ["structured extraction", "reasoning", "confidence scoring", "vision (Llama 3.2 90B Vision)"],
      "apiEndpoint": "/chat/completions",
      "status": "requires META_API_KEY with Llama access"
    }
  },
  "languageSupport": {
    "tier1_full": {
      "description": "Full pipeline: detection + voice + extraction + bot replies + RTL + fonts",
      "languages": [
        { "code": "en", "name": "English", "script": "Latn", "rtl": false },
        { "code": "hi", "name": "Hindi", "script": "Deva", "rtl": false },
        { "code": "ml", "name": "Malayalam", "script": "Mlym", "rtl": false },
        { "code": "te", "name": "Telugu", "script": "Telu", "rtl": false },
        { "code": "ar", "name": "Arabic", "script": "Arab", "rtl": true },
        { "code": "bn", "name": "Bengali", "script": "Beng", "rtl": false },
        { "code": "mr", "name": "Marathi", "script": "Deva", "rtl": false },
        { "code": "ta", "name": "Tamil", "script": "Taml", "rtl": false },
        { "code": "gu", "name": "Gujarati", "script": "Gujr", "rtl": false },
        { "code": "kn", "name": "Kannada", "script": "Knda", "rtl": false },
        { "code": "or", "name": "Odia", "script": "Orya", "rtl": false },
        { "code": "pa", "name": "Punjabi", "script": "Guru", "rtl": false },
        { "code": "as", "name": "Assamese", "script": "Beng", "rtl": false },
        { "code": "ur", "name": "Urdu", "script": "Arab", "rtl": true },
        { "code": "ne", "name": "Nepali", "script": "Deva", "rtl": false },
        { "code": "id", "name": "Indonesian", "script": "Latn", "rtl": false },
        { "code": "sw", "name": "Swahili", "script": "Latn", "rtl": false },
        { "code": "vi", "name": "Vietnamese", "script": "Latn", "rtl": false }
      ]
    },
    "tier2_nllb_only": {
      "description": "NLLB translation + auto-generated bot replies (English fallback)",
      "languages": 80,
      "note": "All 200 NLLB languages supported for translation; bot replies use dynamic template"
    }
  },
  "scripts": [
    { "code": "Latn", "name": "Latin", "direction": "ltr", "languages": 50 },
    { "code": "Deva", "name": "Devanagari", "direction": "ltr", "languages": 15 },
    { "code": "Beng", "name": "Bengali/Assamese", "direction": "ltr", "languages": 4 },
    { "code": "Telu", "name": "Telugu", "direction": "ltr", "languages": 1 },
    { "code": "Taml", "name": "Tamil", "direction": "ltr", "languages": 1 },
    { "code": "Gujr", "name": "Gujarati", "direction": "ltr", "languages": 1 },
    { "code": "Knda", "name": "Kannada", "direction": "ltr", "languages": 1 },
    { "code": "Mlym", "name": "Malayalam", "direction": "ltr", "languages": 1 },
    { "code": "Orya", "name": "Odia", "direction": "ltr", "languages": 1 },
    { "code": "Guru", "name": "Gurmukhi", "direction": "ltr", "languages": 1 },
    { "code": "Arab", "name": "Arabic", "direction": "rtl", "languages": 10 },
    { "code": "Cyrl", "name": "Cyrillic", "direction": "ltr", "languages": 5 },
    { "code": "Hans", "name": "Chinese Simplified", "direction": "ltr", "languages": 1 },
    { "code": "Jpan", "name": "Japanese", "direction": "ltr", "languages": 1 },
    { "code": "Kore", "name": "Korean", "direction": "ltr", "languages": 1 },
    { "code": "Thai", "name": "Thai", "direction": "ltr", "languages": 1 }
  ],
  "integrationPoints": {
    "muse.js": "AI_BACKEND=meta routes to Llama for multilingual extraction",
    "boardcrop.js": "SAM 3.1 unchanged; Llama Vision reads cropped board",
    "malayalam.js": "Refactored to languages/registry/ml.js",
    "eval/run.js": "Multilingual evaluation via NLLB cross-lingual comparison",
    "canvas.js": "getWords(lang) → languages.getReply(lang, key)",
    "onboard.js": "detectLanguage() → languages.detect() for 100+ langs"
  },
  "deployment": {
    "requirements": [
      "META_API_KEY with NLLB, SeamlessM4T, Llama access",
      "Node.js 18+",
      "Sharp (native) for image processing"
    ],
    "environmentVariables": {
      "META_API_KEY": "Meta Model API key (dev.meta.ai)",
      "META_API_BASE": "https://api.meta.ai/v1 (override if needed)",
      "META_MODEL_CHAT": "meta-llama/Llama-3.3-70B-Instruct",
      "META_MODEL_VISION": "meta-llama/Llama-3.2-90B-Vision-Instruct",
      "META_MODEL_TRANSCRIBE": "muse-voice-transcribe (fallback)",
      "NLLB_API_KEY": "Optional separate key for NLLB",
      "SEAMLESS_API_KEY": "Optional separate key for SeamlessM4T",
      "LLAMA_API_KEY": "Optional separate key for Llama"
    }
  }
}